# mx/thrasibule/universe/aws/admin/templates/0000-aws-admin-sso-kms-administrators.cfyml
# ======================================================================================
AWSTemplateFormatVersion: "2010-09-09"
Description: >-
    Create a set of credentials allowing the administration of KMS keys created
    in the _security_ account.

Metadata:
    "TMX::AWSTemplateVersion": "1.0.0"
    "TMX::Owner": "Jimmy Thrasibule <jimmy@thrasibule.mx>"
    "AWS::CloudFormation::Interface":
        ParameterGroups:
            - Label:
                default: "AWS Accounts"
              Parameters:
                - "AdminAccountId"
                - "SecurityAccountId"
            - Label:
                default: "SSO Parameters"
              Parameters:
                - "SSOInstanceArn"
                - "SSOPrincipalId"
                - "SSOPrincipalType"
            - Label:
                default: "Stack"
              Parameters:
                - "Prefix"

Parameters:
    AdminAccountId:
        Type: "String"
        Description: "The AWS account identifier of the _admin_ account."
        Default: "479518259644"
        MinLength: 12
        MaxLength: 12
        AllowedPattern: "^\\d{12}$"
        ConstraintDescription: "Must be a valid AWS account number."

    SecurityAccountId:
        Type: "String"
        Description: "The AWS account identifier of the _security_ account."
        Default: "456957523240"
        MinLength: 12
        MaxLength: 12
        AllowedPattern: "^\\d{12}$"
        ConstraintDescription: "Must be a valid AWS account number."

    SSOInstanceArn:
        Type: "String"
        Description: >-
            The ARN of the SSO instance on which to create the resources.
        Default: "arn:aws:sso:::instance/ssoins-6804ddccfa1cfe01"
        MinLength: 43
        MaxLength: 46
        AllowedPattern: "arn:aws:sso:::instance/(sso)?ins-[a-zA-Z0-9-.]{16}"
        ConstraintDescription: >-
            The provided value must be a valid AWS SSO instance ARN.

    SSOPrincipalId:
        Type: "String"
        Description: >-
            The identifier of the user or group which is allowed to administrate
            the KMS keys.
        # SSO Group: TMXSecurityKMSAdministrators
        Default: "9367048bc1-24ad8299-ea6e-4b37-b5ac-dc11d6100402"
        MinLength: 36
        MaxLength: 47
        AllowedPattern: >-
            ^([0-9a-f]{10}-|)[A-Fa-f0-9]{8}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{12}$
        ConstraintDescription: >-
            PrincipalIds are GUIDs
            (For example, f81d4fae-7dec-11d0-a765-00a0c91e6bf6).

    SSOPrincipalType:
        Type: "String"
        Description: "The type of the provided identity."
        Default: "GROUP"
        AllowedValues:
            - "USER"
            - "GROUP"

    Prefix:
        Type: "String"
        Description: "A value prepended to each created resources."
        Default: "TMXKeyManagementService"
        MinLength: 0
        MaxLength: 128
        AllowedPattern: "^[\\w-]*$"
        ConstraintDescription: >-
            Prefix is a string of characters consisting of upper and lowercase
            alphanumeric characters, dash (-) and underscore (_) with no spaces.

Conditions:
    AdminAccount: !Equals [!Ref "AWS::AccountId", !Ref "AdminAccountId"]

Resources:
    SSOPermissionSet:
        Type: "AWS::SSO::PermissionSet"
        Condition: "AdminAccount"
        Properties:
            Name: !Sub "${Prefix}Access"
            InstanceArn: !Ref "SSOInstanceArn"
            Description: >-
                Allow the administration of KMS keys.
            SessionDuration: "PT1H"
            ManagedPolicies:
                - "arn:aws:iam::aws:policy/AWSKeyManagementServicePowerUser"

    SSOAssignment:
        Type: "AWS::SSO::Assignment"
        Condition: "AdminAccount"
        Properties:
            InstanceArn: !Ref "SSOInstanceArn"
            PermissionSetArn: !GetAtt "SSOPermissionSet.PermissionSetArn"
            PrincipalId: !Ref "SSOPrincipalId"
            PrincipalType: !Ref "SSOPrincipalType"
            TargetId: !Ref "SecurityAccountId"
            TargetType: "AWS_ACCOUNT"
