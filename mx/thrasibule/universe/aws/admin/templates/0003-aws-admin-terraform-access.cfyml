# mx/thrasibule/universe/aws/admin/templates/0003-aws-admin-terraform-access.cfyml
# ================================================================================
AWSTemplateFormatVersion: "2010-09-09"
Description: >-
    Create a role in the _admin_ account allowing the administration of the
    account via Terraform.

Metadata:
    "TMX::AWSTemplateVersion": "1.0.0"
    "TMX::Owner": "Jimmy Thrasibule <jimmy@thrasibule.mx>"
    "AWS::CloudFormation::Interface":
        ParameterGroups:
            - Label:
                default: "Terraform Resource Settings"
              Parameters:
                - "TerraformServiceRolePath"
                - "TerraformServiceUserPath"
            - Label:
                default: "AWS Accounts"
              Parameters:
                - "AdminAccountId"
                - "IdAccountId"
            - Label:
                default: "Stack"
              Parameters:
                - "Prefix"

Parameters:
    TerraformServiceRolePath:
        Type: "String"
        Description: >-
            Path location where to create the Terraform administrative
            service role in the _id_ account.
        Default: "/tmx-service-role/"
        MinLength: 1
        MaxLength: 512
        AllowedPattern: "^(/|/[\\w-]+/)$"
        ConstraintDescription: >-
            This parameter allows a string of characters consisting of either a
            forward slash (/) by itself or a string that must begin and end with
            forward slashes.

    TerraformServiceUserPath:
        Type: "String"
        Description: >-
            Path location where to create the Terraform access service user in
            the _id_ account.
        Default: "/tmx-service-user/"
        MinLength: 1
        MaxLength: 512
        AllowedPattern: "^(/|/[\\w-]+/)$"
        ConstraintDescription: >-
            This parameter allows a string of characters consisting of either a
            forward slash (/) by itself or a string that must begin and end with
            forward slashes.

    AdminAccountId:
        Type: "String"
        Description: "The AWS account identifier of the _admin_ account."
        Default: "479518259644"
        MinLength: 12
        MaxLength: 12
        AllowedPattern: "^\\d{12}$"
        ConstraintDescription: "Must be a valid AWS account number."

    IdAccountId:
        Type: "String"
        Description: "The AWS account identifier of the _id_ account."
        Default: "276324087202"
        MinLength: 12
        MaxLength: 12
        AllowedPattern: "^\\d{12}$"
        ConstraintDescription: "Must be a valid AWS account number."

    Prefix:
        Type: "String"
        Description: "A value prepended to each created resources."
        Default: "TMXTerraform"
        MinLength: 0
        MaxLength: 128
        AllowedPattern: "^[\\w-]*$"
        ConstraintDescription: >-
            Prefix is a string of characters consisting of upper and lowercase
            alphanumeric characters, dash (-) and underscore (_) with no spaces.

Outputs:
    TerraformAdministrationRoleArn:
        Condition: "IsAdminAccount"
        Description: >-
            The ARN of the role to be assumed by Terraform in order to
            administrate the account.
        Value: !GetAtt "TerraformAdministrationRole.Arn"
        Export:
            Name: !Sub "TMX::AWS::${AWS::AccountId}::Stack::Terraform::AdministrationRoleArn"

Conditions:
    IsAdminAccount: !Equals [!Ref "AWS::AccountId", !Ref "AdminAccountId"]

Resources:
    # Terraform will assume this role in order to administrate the account.
    TerraformAdministrationRole:
        Type: "AWS::IAM::Role"
        Condition: "IsAdminAccount"
        Properties:
            RoleName: !Sub "${Prefix}AdministrationRole"
            Path: !Ref "TerraformServiceRolePath"
            AssumeRolePolicyDocument:
                Version: "2012-10-17"
                Statement:
                    - Effect: "Allow"
                      Principal:
                        AWS: !Sub "arn:aws:iam::${IdAccountId}:root"
                      Action:
                        - "sts:AssumeRole"
                      Condition:
                        StringEquals:
                            "sts:ExternalId":
                                "Fn::Base64": !Join
                                    - "_"
                                    - - !Ref "Prefix"
                                      - !Ref "AWS::Partition"
                                      - !Ref "AWS::AccountId"
            ManagedPolicyArns:
                - "arn:aws:iam::aws:policy/AdministratorAccess"
