# mx/thrasibule/universe/aws/universe/templates/tfstate/0002-aws-org-terraform-access.cfyml
# =========================================================================================
AWSTemplateFormatVersion: "2010-09-09"
Description: >-
    Create the set of credentials allowing the administration of the entire
    organization via Terraform.

Metadata:
    "TMX::AWSTemplateVersion": "1.0.0"
    "TMX::Owner": "Jimmy Thrasibule <jimmy@thrasibule.mx>"
    "AWS::CloudFormation::Interface":
        ParameterGroups:
            - Label:
                default: "Terraform Resource Settings"
              Parameters:
                - "TerraformStateDynamoDBKMSKeyArn"
                - "TerraformStateS3BucketKMSKeyArn"
                - "TerraformServiceRolePath"
                - "TerraformServiceUserPath"
            - Label:
                default: "AWS Accounts"
              Parameters:
                - "IdAccountId"
                - "UniverseAccountId"
            - Label:
                default: "Stack"
              Parameters:
                - "Prefix"

Mappings:
    AWSAccount:
        admin:
            AccountId: "479518259644"
        audit:
            AccountId: "157082376293"
        id:
            AccountId: "276324087202"
        logging:
            AccountId: "688842018105"
        sandbox:
            AccountId: "386068839781"
        security:
            AccountId: "456957523240"
        universe:
            AccountId: "314637056362"
        v25c:
            AccountId: "149334242673"

Parameters:
    TerraformStateDynamoDBKMSKeyArn:
        Type: "String"
        Description: >-
            The ARN of the KMS key used to encrypt the data into the Terraform
            DynamoDB table.
        AllowedPattern: "^arn:aws:kms:[\\w-]+:\\d{12}:key/[0-9a-z-]+$"

    TerraformStateS3BucketKMSKeyArn:
        Type: "String"
        Description: >-
            The ARN of the KMS key used to encrypt the data into the Terraform
            S3 bucket.
        AllowedPattern: "^arn:aws:kms:[\\w-]+:\\d{12}:key/[0-9a-z-]+$"

    TerraformServiceRolePath:
        Type: "String"
        Description: >-
            Path location where to create the Terraform administrative
            service role in the _id_ account.
        Default: "/tmx-service-role/"
        MinLength: 1
        MaxLength: 512
        AllowedPattern: "^(/|/[\\w-]+/)$"
        ConstraintDescription: >-
            This parameter allows a string of characters consisting of either a
            forward slash (/) by itself or a string that must begin and end with
            forward slashes.

    TerraformServiceUserPath:
        Type: "String"
        Description: >-
            Path location where to create the Terraform access service user in
            the _id_ account.
        Default: "/tmx-service-user/"
        MinLength: 1
        MaxLength: 512
        AllowedPattern: "^(/|/[\\w-]+/)$"
        ConstraintDescription: >-
            This parameter allows a string of characters consisting of either a
            forward slash (/) by itself or a string that must begin and end with
            forward slashes.

    IdAccountId:
        Type: "String"
        Description: "The AWS account identifier of the _id_ account."
        Default: "276324087202"
        MinLength: 12
        MaxLength: 12
        AllowedPattern: "^\\d{12}$"
        ConstraintDescription: "Must be a valid AWS account number."

    UniverseAccountId:
        Type: "String"
        Description: "The AWS account identifier of the _universe_ account."
        Default: "314637056362"
        MinLength: 12
        MaxLength: 12
        AllowedPattern: "^\\d{12}$"
        ConstraintDescription: "Must be a valid AWS account number."

    Prefix:
        Type: "String"
        Description: "A value prepended to each created resources."
        Default: "TMXTerraform"
        MinLength: 0
        MaxLength: 128
        AllowedPattern: "^[\\w-]*$"
        ConstraintDescription: >-
            Prefix is a string of characters consisting of upper and lowercase
            alphanumeric characters, dash (-) and underscore (_) with no spaces.

Outputs:
    TerraformAccessUserArn:
        Condition: "IsIdAccount"
        Description: >-
            The ARN of the user for Terraform to administrate the AWS
            organization.
        Value: !GetAtt "TerraformAccessUser.Arn"
        Export:
            Name: "TMX::Universe::Stack::Terraform::AccessUserArn"

    TerraformAdministrationRoleArn:
        Description: >-
            The ARN of the role to be assumed by Terraform in order to
            administrate the account.
        Value: !GetAtt "TerraformAdministrationRole.Arn"
        Export:
            Name: !Sub "TMX::AWS::${AWS::AccountId}::Stack::Terraform::AdministrationRoleArn"

    TerraformStateUpdateRoleArn:
        Condition: "IsUniverseAccount"
        Description: >-
            The ARN of the role to be assumed by Terraform in order to update
            its state.
        Value: !GetAtt "TerraformStateUpdateRole.Arn"
        Export:
            Name: "TMX::Universe::Stack::Terraform::StateUpdateRoleArn"

Conditions:
    IsIdAccount: !Equals [!Ref "AWS::AccountId", !Ref "IdAccountId"]
    IsUniverseAccount: !Equals [!Ref "AWS::AccountId", !Ref "UniverseAccountId"]

Resources:
    # Terraform will assume this role in order to administrate the account.
    TerraformAdministrationRole:
        Type: "AWS::IAM::Role"
        Properties:
            RoleName: !Sub "${Prefix}AdministrationRole"
            Path: !Ref "TerraformServiceRolePath"
            AssumeRolePolicyDocument:
                Version: "2012-10-17"
                Statement:
                    - Effect: "Allow"
                      Principal:
                        AWS: !Sub "arn:aws:iam::${IdAccountId}:root"
                      Action:
                        - "sts:AssumeRole"
                      Condition:
                        StringEquals:
                            "sts:ExternalId":
                                "Fn::Base64": !Join
                                    - "_"
                                    - - !Ref "Prefix"
                                      - !Ref "AWS::Partition"
                                      - !Ref "AWS::AccountId"
            ManagedPolicyArns:
                - "arn:aws:iam::aws:policy/AdministratorAccess"

    # Terraform will assume this role in order to update its global state.
    TerraformStateUpdateRole:
        Type: "AWS::IAM::Role"
        Condition: "IsUniverseAccount"
        Properties:
            RoleName: !Sub "${Prefix}StateUpdateRole"
            Path: !Ref "TerraformServiceRolePath"
            AssumeRolePolicyDocument:
                Version: "2012-10-17"
                Statement:
                    - Effect: "Allow"
                      Principal:
                        AWS: !Sub "arn:aws:iam::${IdAccountId}:root"
                      Action:
                        - "sts:AssumeRole"
                      Condition:
                        StringEquals:
                            "sts:ExternalId":
                                "Fn::Base64": !Join
                                    - "_"
                                    - - !Ref "Prefix"
                                      - !Ref "AWS::Partition"
                                      - !Ref "AWS::AccountId"
            Policies:
                - PolicyName: !Sub "${Prefix}DynamoDBStatePolicy"
                  PolicyDocument:
                    Version: "2012-10-17"
                    Statement:
                        - Effect: "Allow"
                          Action:
                            - "dynamodb:DeleteItem"
                            - "dynamodb:DescribeTable"
                            - "dynamodb:GetItem"
                            - "dynamodb:PutItem"
                            - "dynamodb:Query"
                            - "dynamodb:UpdateItem"
                          Resource: !ImportValue "TMX::Universe::Stack::Terraform::StateDynamoDBTableArn"

                - PolicyName: !Sub "${Prefix}S3StatePolicy"
                  PolicyDocument:
                    Version: "2012-10-17"
                    Statement:
                        - Effect: "Allow"
                          Action:
                            - "s3:ListBucket"
                          Resource: !ImportValue "TMX::Universe::Stack::Terraform::StateS3BucketArn"
                        - Effect: "Allow"
                          Action:
                            - "s3:DeleteObject"
                            - "s3:GetObject"
                          Resource: !Join
                            - "/"
                            - - !ImportValue "TMX::Universe::Stack::Terraform::StateS3BucketArn"
                              - "*"
                        - Effect: "Allow"
                          Action:
                            - "s3:PutObject"
                            - "s3:PutObjectAcl"
                          Resource: !Join
                            - "/"
                            - - !ImportValue "TMX::Universe::Stack::Terraform::StateS3BucketArn"
                              - "*"
                          Condition:
                            StringEquals:
                                "s3:x-amz-acl": "bucket-owner-full-control"

                - PolicyName: !Sub "${Prefix}DynamoDBStateKMSKeyPolicy"
                  PolicyDocument:
                    Version: "2012-10-17"
                    Statement:
                        - Effect: "Allow"
                          Action:
                            - "kms:DescribeKey"
                          Resource: !Ref "TerraformStateDynamoDBKMSKeyArn"
                          Condition:
                            StringEquals:
                                "kms:CallerAccount": !Ref "AWS::AccountId"
                                "kms:ViaService":
                                    - !Sub "dynamodb.${AWS::Region}.amazonaws.com"
                        - Effect: "Allow"
                          Action:
                            - "kms:Decrypt"
                            - "kms:Encrypt"
                            - "kms:GenerateDataKey*"
                            - "kms:ReEncrypt*"
                          Resource: !Ref "TerraformStateDynamoDBKMSKeyArn"
                          Condition:
                            StringEquals:
                                "kms:CallerAccount": !Ref "AWS::AccountId"
                                "kms:EncryptionContext:aws:dynamodb:tableName": !ImportValue "TMX::Universe::Stack::Terraform::StateDynamoDBTableName"
                                "kms:EncryptionContext:aws:dynamodb:subscriberId": !Ref "AWS::AccountId"
                                "kms:ViaService":
                                    - !Sub "dynamodb.${AWS::Region}.amazonaws.com"
                        - Effect: "Allow"
                          Action:
                            - "kms:CreateGrant"
                            - "kms:ListGrants"
                            - "kms:RevokeGrant"
                          Resource: !Ref "TerraformStateDynamoDBKMSKeyArn"
                          Condition:
                            Bool:
                                "kms:GrantIsForAWSResource": true
                            StringEquals:
                                "kms:CallerAccount": !Ref "AWS::AccountId"
                                "kms:ViaService":
                                    - !Sub "dynamodb.${AWS::Region}.amazonaws.com"

                - PolicyName: !Sub "${Prefix}S3StateKMSKeyPolicy"
                  PolicyDocument:
                    Version: "2012-10-17"
                    Statement:
                        - Effect: "Allow"
                          Action:
                            - "kms:DescribeKey"
                          Resource: !Ref "TerraformStateS3BucketKMSKeyArn"
                          Condition:
                            StringEquals:
                                "kms:CallerAccount": !Ref "AWS::AccountId"
                                "kms:ViaService":
                                    - !Sub "s3.${AWS::Region}.amazonaws.com"
                        - Effect: "Allow"
                          Action:
                            - "kms:Decrypt"
                            - "kms:Encrypt"
                            - "kms:GenerateDataKey*"
                            - "kms:ReEncrypt*"
                          Resource: !Ref "TerraformStateS3BucketKMSKeyArn"
                          Condition:
                            StringEquals:
                                "kms:CallerAccount": !Ref "AWS::AccountId"
                                "kms:EncryptionContext:aws-s3-arn": !ImportValue "TMX::Universe::Stack::Terraform::StateS3BucketArn"
                                "kms:ViaService":
                                    - !Sub "s3.${AWS::Region}.amazonaws.com"
                        - Effect: "Allow"
                          Action:
                            - "kms:CreateGrant"
                            - "kms:ListGrants"
                            - "kms:RevokeGrant"
                          Resource: !Ref "TerraformStateS3BucketKMSKeyArn"
                          Condition:
                            Bool:
                                "kms:GrantIsForAWSResource": true
                            StringEquals:
                                "kms:CallerAccount": !Ref "AWS::AccountId"
                                "kms:ViaService":
                                    - !Sub "s3.${AWS::Region}.amazonaws.com"

    TerraformAccessUser:
        Type: "AWS::IAM::User"
        Condition: "IsIdAccount"
        Properties:
            UserName: !Sub "${Prefix}User"
            Path: !Ref "TerraformServiceUserPath"
            Policies:
                - PolicyName: !Sub "${Prefix}AssumeAdministrationPolicy"
                  PolicyDocument:
                    Version: "2012-10-17"
                    Statement:
                        - Effect: "Allow"
                          Action:
                            "sts:AssumeRole"
                          Resource:
                            - !Join [":", ["arn:aws:iam:", !FindInMap ["AWSAccount", "admin", "AccountId"], !Sub "role${TerraformServiceRolePath}${Prefix}AdministrationRole"]]
                            - !Join [":", ["arn:aws:iam:", !FindInMap ["AWSAccount", "audit", "AccountId"], !Sub "role${TerraformServiceRolePath}${Prefix}AdministrationRole"]]
                            - !Join [":", ["arn:aws:iam:", !FindInMap ["AWSAccount", "id", "AccountId"], !Sub "role${TerraformServiceRolePath}${Prefix}AdministrationRole"]]
                            - !Join [":", ["arn:aws:iam:", !FindInMap ["AWSAccount", "logging", "AccountId"], !Sub "role${TerraformServiceRolePath}${Prefix}AdministrationRole"]]
                            - !Join [":", ["arn:aws:iam:", !FindInMap ["AWSAccount", "sandbox", "AccountId"], !Sub "role${TerraformServiceRolePath}${Prefix}AdministrationRole"]]
                            - !Join [":", ["arn:aws:iam:", !FindInMap ["AWSAccount", "security", "AccountId"], !Sub "role${TerraformServiceRolePath}${Prefix}AdministrationRole"]]
                            - !Join [":", ["arn:aws:iam:", !FindInMap ["AWSAccount", "universe", "AccountId"], !Sub "role${TerraformServiceRolePath}${Prefix}AdministrationRole"]]
                            - !Join [":", ["arn:aws:iam:", !FindInMap ["AWSAccount", "v25c", "AccountId"], !Sub "role${TerraformServiceRolePath}${Prefix}AdministrationRole"]]
                - PolicyName: !Sub "${Prefix}AssumeStateUpdatePolicy"
                  PolicyDocument:
                    Version: "2012-10-17"
                    Statement:
                        - Effect: "Allow"
                          Action:
                            "sts:AssumeRole"
                          Resource:
                            - !Join [":", ["arn:aws:iam:", !FindInMap ["AWSAccount", "universe", "AccountId"], !Sub "role${TerraformServiceRolePath}${Prefix}StateUpdateRole"]]
            Tags:
                - Key: "TMX::Owner"
                  Value: "jimmy@thrasibule.mx"
                - Key: "TMX::Service"
                  Value: "terraform"
