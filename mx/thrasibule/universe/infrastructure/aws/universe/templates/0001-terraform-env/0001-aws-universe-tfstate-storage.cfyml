# mx/thrasibule/universe/aws/universe/templates/tfstate/0001-aws-universe-tfstate-storage.cfyml
# =============================================================================================
AWSTemplateFormatVersion: "2010-09-09"
Description: >-
    Create in the _universe_ account the required storage resources in order to
    keep the Terraform state.

Metadata:
    "TMX::AWSTemplateVersion": "1.0.0"
    "TMX::AWSTemplateOwner": "Jimmy Thrasibule <jimmy@thrasibule.mx>"
    "AWS::CloudFormation::Interface":
        ParameterGroups:
            - Label:
                default: "DynamoDB Setting"
              Parameters:
                - "TerraformStateDynamoDBTableName"
                - "TerraformStateDynamoDBKMSKeyArn"
            - Label:
                default: "S3 Setting"
              Parameters:
                - "TerraformStateS3BucketName"
                - "TerraformStateS3BucketKMSKeyArn"
            - Label:
                default: "AWS Accounts"
              Parameters:
                - "UniverseAccountId"

Parameters:
    TerraformStateDynamoDBTableName:
        Type: "String"
        Description: >-
            The name of the DynamoDB table storing the Terraform state.
        Default: "tfstate"
        MinLength: 3
        MaxLength: 255
        AllowedPattern: "[\\w.-]+"
        ConstraintDescription: >-
            The DynamoDB table name can only contain alpha-numeric, period (.)
            and dash (-) characters.

    TerraformStateDynamoDBKMSKeyArn:
        Type: "String"
        Description: >-
            The ARN of the KMS key used to encrypt the data into the Terraform
            DynamoDB table.
        AllowedPattern: "^arn:aws:kms:[\\w-]+:\\d{12}:key/[0-9a-z-]+$"

    TerraformStateS3BucketName:
        Type: "String"
        Description: >-
            Name of the S3 bucket storing the Terraform state.
        Default: "tmx-universe-tfstate"
        MinLength: 1
        MaxLength: 1024
        AllowedPattern: "^[0-9a-z.-]+$"
        ConstraintDescription: >-
            The bucket name must contain only lowercase letters, numbers,
            periods (.), and dashes (-).

    TerraformStateS3BucketKMSKeyArn:
        Type: "String"
        Description: >-
            The ARN of the KMS key used to encrypt the data into the Terraform
            S3 bucket.
        AllowedPattern: "^arn:aws:kms:[\\w-]+:\\d{12}:key/[0-9a-z-]+$"

    UniverseAccountId:
        Type: "String"
        Description: "The AWS account identifier of the _universe_ account."
        Default: "314637056362"
        MinLength: 12
        MaxLength: 12
        AllowedPattern: "^\\d{12}$"
        ConstraintDescription: "Must be a valid AWS account number."

Outputs:
    TerraformStateDynamoDBTableName:
        Condition: "IsUniverseAccount"
        Description: >-
            Name of the DynamoDB table storing the Terraform state.
        Value: !Ref "TerraformStateDynamoDBTable"
        Export:
            Name: "TMX::Universe::Stack::Terraform::StateDynamoDBTableName"

    TerraformStateDynamoDBTableArn:
        Condition: "IsUniverseAccount"
        Description: >-
            ARN of the DynamoDB table storing the Terraform state.
        Value: !GetAtt "TerraformStateDynamoDBTable.Arn"
        Export:
            Name: "TMX::Universe::Stack::Terraform::StateDynamoDBTableArn"

    TerraformStateS3BuketName:
        Condition: "IsUniverseAccount"
        Description: >-
            Name of the S3 bucket storing the Terraform state.
        Value: !Ref "TerraformStateS3Bucket"
        Export:
            Name: "TMX::Universe::Stack::Terraform::StateS3BucketName"

    TerraformStateS3BuketArn:
        Condition: "IsUniverseAccount"
        Description: >-
            ARN of the S3 bucket storing the Terraform state.
        Value: !GetAtt "TerraformStateS3Bucket.Arn"
        Export:
            Name: "TMX::Universe::Stack::Terraform::StateS3BucketArn"

Conditions:
    IsUniverseAccount: !Equals [!Ref "AWS::AccountId", !Ref "UniverseAccountId"]

Resources:
    TerraformStateDynamoDBTable:
        Type: "AWS::DynamoDB::Table"
        Condition: "IsUniverseAccount"
        DeletionPolicy: "Delete"
        Properties:
            TableName: !Ref "TerraformStateDynamoDBTableName"
            AttributeDefinitions:
                - AttributeName: "LockID"
                  AttributeType: "S"
            BillingMode: "PAY_PER_REQUEST"
            KeySchema:
                - AttributeName: "LockID"
                  KeyType: "HASH"
            SSESpecification:
                KMSMasterKeyId: !Ref "TerraformStateDynamoDBKMSKeyArn"
                SSEEnabled: true
                SSEType: "KMS"
            Tags:
                - Key: "TMX::Owner"
                  Value: "jimmy@thrasibule.mx"
                - Key: "TMX::AWSAccountName"
                  Value: "universe"
                - Key: "TMX:AWSAccountId"
                  Value: !Ref "AWS::AccountId"

    TerraformStateS3Bucket:
        Type: "AWS::S3::Bucket"
        Condition: "IsUniverseAccount"
        DeletionPolicy: "Delete"
        Properties:
            AccessControl: "Private"
            BucketName: !Ref "TerraformStateS3BucketName"
            BucketEncryption:
                ServerSideEncryptionConfiguration:
                    - BucketKeyEnabled: true
                      ServerSideEncryptionByDefault:
                        KMSMasterKeyID: !Ref "TerraformStateS3BucketKMSKeyArn"
                        SSEAlgorithm: "aws:kms"
            LifecycleConfiguration:
                Rules:
                    - Status: "Enabled"
                      NoncurrentVersionExpirationInDays: 30
                      AbortIncompleteMultipartUpload:
                        DaysAfterInitiation: 7
                      Transitions:
                        - TransitionInDays: 30
                          StorageClass: "STANDARD_IA"
            OwnershipControls:
                Rules:
                    - ObjectOwnership: "BucketOwnerPreferred"
            PublicAccessBlockConfiguration:
                BlockPublicAcls: true
                BlockPublicPolicy: true
                IgnorePublicAcls: true
                RestrictPublicBuckets: true
            VersioningConfiguration:
                Status: "Enabled"
            Tags:
                - Key: "TMX::Owner"
                  Value: "jimmy@thrasibule.mx"
                - Key: "TMX::AWSAccountName"
                  Value: "universe"
                - Key: "TMX:AWSAccountId"
                  Value: !Ref "AWS::AccountId"

    TerraformStateS3BucketPolicy:
        Type: "AWS::S3::BucketPolicy"
        Condition: "IsUniverseAccount"
        Properties:
            Bucket: !Ref "TerraformStateS3Bucket"
            PolicyDocument:
                Version: "2012-10-17"
                Statement:
                    - Effect: "Deny"
                      Principal: "*"
                      Action: "s3:*"
                      Resource:
                          - !GetAtt "TerraformStateS3Bucket.Arn"
                          - !Sub "${TerraformStateS3Bucket.Arn}/*"
                      Condition:
                        Bool:
                            "aws:SecureTransport": false
                    - Effect: "Allow"
                      Principal:
                        AWS:
                            - !Sub "arn:aws:iam::${UniverseAccountId}:root"
                      Action:
                        - "s3:GetBucketLocation"
                        - "s3:GetBucketTagging"
                        - "s3:GetBucketVersioning"
                        - "s3:ListBucket"
                        - "s3:ListBucketVersions"
                        - "s3:ListBucketMultipartUploads"
                      Resource:
                        - !GetAtt "TerraformStateS3Bucket.Arn"
                    - Effect: "Allow"
                      Principal:
                        AWS:
                            - !Sub "arn:aws:iam::${UniverseAccountId}:root"
                      Action:
                        - "s3:AbortMultipartUpload"
                        - "s3:DeleteObject"
                        - "s3:DeleteObjectTagging"
                        - "s3:DeleteObjectVersion"
                        - "s3:DeleteObjectVersionTagging"
                        - "s3:GetObject"
                        - "s3:GetObjectTagging"
                        - "s3:GetObjectVersion"
                        - "s3:GetObjectVersionTagging"
                        - "s3:ListMultipartUploadParts"
                        - "s3:PutObjectTagging"
                        - "s3:PutObjectVersionTagging"
                      Resource:
                        - !Sub "${TerraformStateS3Bucket.Arn}/*"
                    - Effect: "Allow"
                      Principal:
                        AWS:
                            - !Sub "arn:aws:iam::${UniverseAccountId}:root"
                      Action:
                        - "s3:PutObject"
                        - "s3:PutObjectAcl"
                      Resource: !Sub "${TerraformStateS3Bucket.Arn}/*"
                      Condition:
                        StringEquals:
                            "s3:x-amz-acl": "bucket-owner-full-control"
